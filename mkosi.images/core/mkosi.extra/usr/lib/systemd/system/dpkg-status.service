# Reconstruit /var/lib/dpkg/status a partir de /usr/lib/sysimage/dpkg/status.d/
# (l'image et ses extensions, voir finalize-dpkg).

[Unit]
Description=Merge the dpkg status of the image and its extensions
Documentation=man:dpkg-query(1)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=sh -c 'cat /usr/lib/sysimage/dpkg/status.d/* >/var/lib/dpkg/status'
